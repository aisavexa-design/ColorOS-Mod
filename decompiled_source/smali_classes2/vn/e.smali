    const-string p0, "half4 blendOptics(float2 coords, CommonDataRect rectData, half4 color, float d, float mix_c){\n    vec4 opticsColor = vec4(u_opticsArray[0],u_opticsArray[1],u_opticsArray[2],u_opticsArray[3]);\n    float gray = clamp((dot(float3(0.2126, 0.7152, 0.0722), color.rgb) - 0.6) * 1.6, 0.0, 1.0);\n    opticsColor[3] =  u_opticsArray[3]*(1.0 - gray)*(1.0-gray);\n    if(opticsColor[3]>0.001){\n        vec2 pos_optics = (rectData.pos - vec2(u_opticsArray[4],u_opticsArray[5])) ;\n        float opticsSdf = u_opticsArray[8];\n        vec2 halfSizeOptics = rectData.halfSize*vec2(u_opticsArray[6],u_opticsArray[7]);\n        if(all(lessThanEqual(abs(pos_optics), halfSizeOptics+u_opticsArray[8]))){\n            float conerOptics = min(rectData.coner, min(halfSizeOptics.x,halfSizeOptics.y));\n            opticsSdf = RBox(pos_optics, halfSizeOptics, conerOptics);\n            float value = smoothstep(u_opticsArray[8], 0.0, opticsSdf);\n            vec2 uv_pos = coords.xy*0.0127;\n            float n = clamp((random(uv_pos)-.5)*0.01+.5,0.,1.);\n            value = clamp(softLight(n,value),0.0,1.0);\n            opticsColor.a *= value*mix_c;\n            opticsColor.rgb = color.rgb+opticsColor.rgb;\n            color = half4(clamp(mix(color.rgb, opticsColor.rgb, opticsColor.a), 0.0,1.0),1.0);\n        }\n    }\n    return color;\n}"

